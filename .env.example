# Application Settings
APP_NAME=AI Agent Knowledge System
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector Database Configuration
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=./vector_store
PINCONE_API_KEY=your_pinecone_api_key_here
PINCONE_ENVIRONMENT=us-west1-gcp
PINCONE_INDEX_NAME=ai-knowledge-index

# Document Processing
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SUPPORTED_FORMATS=pdf,txt,csv,xlsx,docx,json,yaml

# Retrieval Configuration
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.5

# Agent Configuration
AGENT_TYPE=react
AGENT_TIMEOUT=300
MAX_ITERATIONS=10

# Security
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Storage Paths
UPLOAD_DIR=./uploaded_documents
PROCESSED_DIR=./processed_data
LOG_DIR=./logs
